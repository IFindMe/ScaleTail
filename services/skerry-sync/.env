#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name (e.g., adguard). Used as hostname in Tailscale and for container naming.
SERVICE=skerry-sync
# Docker image URL from container registry (e.g., adguard/adguardhome:latest).
IMAGE_URL=secherkasov/skerry-sync:latest

# Network Configuration
# Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
SERVICEPORT=8080
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Any Container environment variables are declared below. See https://docs.docker.com/compose/how-tos/environment-variables/

# Required: JWT signing secret. Generate it with: openssl rand -base64 48
# Keep it stable across restarts, or all issued tokens are invalidated.
SKERRY_JWT_SECRET=
# Operator console token for /console and /admin/*. Generate it with: openssl rand -hex 16
# Leave it empty to keep the admin data endpoints closed.
SKERRY_ADMIN_TOKEN=
# Database URL. The default keeps everything in the SQLite file inside the data folder.
SKERRY_DB_URL=jdbc:sqlite:/data/skerry-sync.db
# Database user and password. Leave empty for SQLite, set both for PostgreSQL below.
SKERRY_DB_USER=
SKERRY_DB_PASSWORD=

# PostgreSQL instead of SQLite. Uncomment the db service in compose.yaml and its depends_on
# entry, set SKERRY_DB_URL to jdbc:postgresql://localhost:5432/skerry, and set the two values below.
# User of the database. The database name is skerry.
#SKERRY_DB_USER=skerry
# Password of the database. Generate it with: openssl rand -hex 32
#SKERRY_DB_PASSWORD=
