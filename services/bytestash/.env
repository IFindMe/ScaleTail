#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name (e.g., adguard). Used as hostname in Tailscale and for container naming.
SERVICE=bytestash
# Docker image URL from container registry (e.g., adguard/adguardhome:latest).
IMAGE_URL=ghcr.io/jordan-dalby/bytestash:latest

# Network Configuration
# Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
SERVICEPORT=5000
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Any Container environment variables are declared below. See https://docs.docker.com/compose/how-tos/environment-variables/

# URL prefix, e.g. /bytestash. Leave empty in most cases.
BASE_PATH=
# Session lifetime, e.g. 24h or 7d.
TOKEN_EXPIRY=24h
# Whether the instance accepts new account registrations.
ALLOW_NEW_ACCOUNTS=true
# Verbose logging. Leave false in most cases.
DEBUG=false
# Act as a single auto-authenticated user, bypassing login and registration.
DISABLE_ACCOUNTS=false
# Disable internal accounts entirely, for single sign-on only deployments.
DISABLE_INTERNAL_ACCOUNTS=false

# Optional settings. Uncomment the matching lines in compose.yaml when you use one.
# Pin the JWT secret. Generate it with: openssl rand -hex 32
# Leave it empty to let the app generate and store one in ./bytestash-data/snippets.
#JWT_SECRET=
# Restrict accepted host headers, comma-separated.
#ALLOWED_HOSTS=
# Single sign-on via OIDC. See: https://github.com/jordan-dalby/ByteStash/wiki/Single-Sign%E2%80%90on-Setup
#OIDC_ENABLED=false
#OIDC_DISPLAY_NAME=
#OIDC_ISSUER_URL=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=

# PostgreSQL instead of SQLite. Uncomment the db service in compose.yaml, its depends_on entry,
# and the POSTGRES_* lines in application.environment when you use it.
# Password of the database. Generate it with: openssl rand -hex 32
#POSTGRES_PASSWORD=
#POSTGRES_USER=bytestash
#POSTGRES_DB=bytestash
# Copy existing SQLite data into PostgreSQL on first start. It only runs while PostgreSQL is empty.
#MIGRATE_SQLITE_TO_POSTGRES=true
